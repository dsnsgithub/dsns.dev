---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Audio Frequency Analyzer" description="Test headphones/speakers by uploading an audio file and sculpting the sound.">
	<div class="container mx-auto flex flex-col gap-10 px-1 md:px-8 lg:px-10 xl:px-32 2xl:px-48">
		<div id="app-container" class="w-full rounded-2xl bg-viola-100 p-10 shadow-2xl">
			<section class="space-y-2">
				<h1 class="text-3xl font-bold">Audio Frequency Analyzer</h1>
				<p>
					Test headphones/speakers by uploading an audio file and sculpting the sound.
					<div class="mt-2 flex flex-wrap gap-3">
						<a href="/symbolism.mp3" download class="inline-flex items-center gap-1 rounded-lg bg-viola-200 px-3 py-1 text-sm font-medium shadow-sm transition hover:bg-viola-300">
							🌌 <span>Symbolism</span>
						</a>
						<a href="/invincible.mp3" download class="inline-flex items-center gap-1 rounded-lg bg-viola-200 px-3 py-1 text-sm font-medium shadow-sm transition hover:bg-viola-300">
							💪 <span>Invincible</span>
						</a>
						<a href="/mortals.mp3" download class="inline-flex items-center gap-1 rounded-lg bg-viola-200 px-3 py-1 text-sm font-medium shadow-sm transition hover:bg-viola-300">
							🥁 <span>Mortals</span>
						</a>
					</div>
				</p>
			</section>

			<section class="mt-8 space-y-4">
				<div class="flex flex-row flex-wrap items-center gap-4">
					<input
						type="file"
						id="audio-file"
						accept=".mp3,.flac,.wav, .m4a, .ogg, .aac"
						class="block rounded-lg border border-viola-300 bg-viola-50 px-3 py-2 text-sm file:mr-4 file:rounded-lg file:border-0 file:bg-viola-200 file:px-4 file:py-2 hover:file:bg-viola-300 focus:outline-hidden focus:ring-2 focus:ring-viola-400"
					/>

					<div class="relative flex items-center gap-2 rounded-lg border border-viola-300 bg-viola-200 p-4 shadow-xl">
						<label for="detail-slider" class="text-sm">Detail:</label>
						<input
							type="range"
							id="detail-slider"
							min="8"
							max="15"
							value="13"
							class="h-2 w-32 cursor-pointer appearance-none rounded-lg bg-viola-300 [&::-moz-range-thumb]:h-4 [&::-moz-range-thumb]:w-4 [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:bg-viola-500 [&::-moz-range-thumb]:transition [&::-moz-range-thumb]:hover:bg-viola-600 [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-viola-500 [&::-webkit-slider-thumb]:transition [&::-webkit-slider-thumb]:hover:bg-viola-600"
							oninput="document.getElementById('detail-tooltip').textContent = Math.pow(2, this.value); document.getElementById('detail-tooltip').style.opacity = 1;"
							onchange="document.getElementById('detail-tooltip').style.opacity = 0;"
							onblur="document.getElementById('detail-tooltip').style.opacity = 0;"
						/>
						<span
							id="detail-tooltip"
							class="pointer-events-none absolute left-1/2 top-10 -translate-x-1/2 rounded-sm bg-viola-800 px-2 py-1 text-xs text-white opacity-0 transition-opacity duration-200"
							style="white-space:nowrap;"
						>
							8192
						</span>
					</div>

					<!-- Audio Controls -->
					<div class="flex flex-1 flex-col items-center rounded-lg border border-viola-300 bg-viola-200 p-4 shadow-xl">
						<audio id="audio-player" controls class="hidden"></audio>
						<div class="flex w-full items-center gap-4">
							<button id="play-pause-btn" class="rounded-full" disabled>
								<svg id="play-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
									<path d="M8 5v14l11-7z"></path>
								</svg>
								<svg id="pause-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="hidden">
									<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
								</svg>
							</button>
							<span id="current-time" class="w-12 text-center text-sm">0:00</span>
							<input
								type="range"
								id="seek-bar"
								value="0"
								class="h-2 w-full cursor-pointer appearance-none rounded-lg bg-viola-300 [&::-moz-range-thumb]:h-4 [&::-moz-range-thumb]:w-4 [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:bg-viola-500 [&::-moz-range-thumb]:transition [&::-moz-range-thumb]:hover:cursor-not-allowed [&::-moz-range-thumb]:hover:bg-viola-600 [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-viola-500 [&::-webkit-slider-thumb]:transition [&::-webkit-slider-thumb]:hover:cursor-not-allowed [&::-webkit-slider-thumb]:hover:bg-viola-600 [&:disabled::-moz-range-thumb]:bg-slate-300 [&:disabled::-webkit-slider-thumb]:bg-slate-300"
								disabled
							/>
							<span id="duration" class="w-12 text-center text-sm">0:00</span>
						</div>
					</div>
				</div>

				<div id="visualizer-wrapper" class="relative h-96 w-full overflow-hidden rounded-lg border border-viola-300 bg-viola-200">
					<canvas id="visualizer-canvas"></canvas>
				</div>

				<div class="text-center text-sm">
					<p>
						Drag on visualization to isolate a frequency range. Add EQ points and move them to desired frequency to EQ.
						<button id="reset-selection-btn" class="ml-2 hidden font-bold">(Reset Selection)</button>
					</p>
				</div>
			</section>

			<section class="mt-12 space-y-4">
				<div id="eq-header" class="hidden flex-wrap items-center justify-between gap-3">
					<div class="flex flex-wrap items-center gap-3">
						<h3 class="text-lg font-semibold">Parametric EQ</h3>
						<label
							for="auto-trim-toggle"
							class="flex cursor-pointer items-center gap-1.5 rounded-lg bg-viola-200 px-2 py-1 text-xs shadow-sm"
							title="Lowers the output by however much the EQ boosts, so a boosted band cannot push the signal into clipping."
						>
							<input type="checkbox" id="auto-trim-toggle" checked class="cursor-pointer accent-viola-600" />
							<span>Auto gain</span>
							<span id="auto-trim-readout" class="font-mono">0.0 dB</span>
						</label>
						<span
							id="limit-indicator"
							class="hidden rounded-lg bg-viola-600 px-2 py-1 text-xs font-medium text-white shadow-sm"
							title="The output limiter is pulling the level down to keep the signal from clipping."
						>
							Limiting
						</span>
					</div>
					<div class="flex gap-2">
						<button id="add-band-btn" class="rounded-lg bg-viola-300 px-3 py-1 text-sm font-medium shadow-sm transition hover:bg-viola-400"> + Add Band </button>
						<button id="reset-eq-btn" class="rounded-lg bg-viola-200 px-3 py-1 text-sm font-medium shadow-sm transition hover:bg-viola-300"> Reset EQ </button>
					</div>
				</div>
				<div id="eq-details" class="grid grid-cols-1 gap-4 pt-4 md:grid-cols-3 lg:grid-cols-5"></div>
			</section>
			<script is:inline>
				document.addEventListener("astro:page-load", () => {
					run();
				});

				function run() {
					// DOM Elements
					const audioFileInput = document.getElementById("audio-file");
					const audioPlayer = document.getElementById("audio-player");
					const visualizerWrapper = document.getElementById("visualizer-wrapper");
					const canvas = document.getElementById("visualizer-canvas");
					const eqDetailsContainer = document.getElementById("eq-details");
					const playPauseBtn = document.getElementById("play-pause-btn");
					const playIcon = document.getElementById("play-icon");
					const pauseIcon = document.getElementById("pause-icon");
					const seekBar = document.getElementById("seek-bar");
					const currentTimeDisplay = document.getElementById("current-time");
					const durationDisplay = document.getElementById("duration");
					const resetSelectionBtn = document.getElementById("reset-selection-btn");
					const addBandBtn = document.getElementById("add-band-btn");
					const resetEqBtn = document.getElementById("reset-eq-btn");
					const autoTrimToggle = document.getElementById("auto-trim-toggle");
					const autoTrimReadout = document.getElementById("auto-trim-readout");
					const limitIndicator = document.getElementById("limit-indicator");

					const ctx = canvas.getContext("2d");

					// --- Audio constants ---
					const MIN_FREQ = 20;
					const AXIS_PAD = 20; // px reserved at the left edge of the plot
					const MAX_GAIN_DB = 20;
					const SELECTION_ORDER = 16; // Butterworth sections per edge x2, i.e. 96 dB/oct
					const PARAM_TC = 0.012; // AudioParam smoothing time constant, seconds
					const XFADE_TC = 0.01;
					const TRIM_TC = 0.05;
					const LIMITER_THRESHOLD_DB = -1; // where gain reduction starts
					const LIMIT_INDICATOR_DB = -3; // smoothed reduction past which we tell the user
					const CLIP_KNEE = 0.98; // soft-clipper knee in linear sample units
					const CLIP_HEADROOM = 2; // soft-clipper handles input up to +6 dBFS
					const MIN_SELECTION_RATIO = 1.05; // narrowest selection we will build a band for
					const RESPONSE_POINTS = 256;
					const SPECTRUM_BAR_PX = 2; // target width of one drawn spectrum column

					// Audio Context and Nodes
					let audioContext;
					let sourceNode;
					let analyserNode;
					let trimNode; // automatic gain compensation for EQ boosts
					let limiterNode; // catches overshoot by pulling gain down, not by reshaping
					let clipInGain; // scales the signal into the soft-clipper's input range
					let softClipNode; // last resort for the transients the limiter's attack misses
					let dryGain, wetGain; // crossfade around the selection filters
					let selectionHighpass = [];
					let selectionLowpass = [];
					let bands = []; // { node, type, freq, gain, q }

					// State
					let isPlaying = false;
					let isDraggingPoint = null;
					let isSelectingRange = false;
					let selectionActive = false;
					let autoTrimEnabled = true;
					let smoothedReduction = 0;
					let selectionRect = { startX: 0, endX: 0, startFreq: 0, endFreq: 0 };
					let spectrumData = null;
					let spectrumColumns = [];
					let spectrumColumnsKey = "";
					let barGradient = null;

					const detailSlider = document.getElementById("detail-slider");
					const detailTooltip = document.getElementById("detail-tooltip");
					if (detailSlider && detailTooltip) {
						detailSlider.addEventListener("input", () => {
							detailTooltip.textContent = Math.pow(2, detailSlider.value);
							detailTooltip.style.opacity = 1;

							setTimeout(() => {
								detailTooltip.style.opacity = 0;
							}, 1000);
						});

						detailSlider.addEventListener("mouseover", () => {
							detailTooltip.style.opacity = 1;
						});

						detailSlider.addEventListener("mouseout", () => {
							detailTooltip.style.opacity = 0;
						});

						detailSlider.addEventListener("change", () => {
							detailTooltip.style.opacity = 0;
						});
						detailSlider.addEventListener("blur", () => {
							detailTooltip.style.opacity = 0;
						});
					}

					// --- Audio helpers ---

					function nyquist() {
						return audioContext ? audioContext.sampleRate / 2 : 22050;
					}

					function maxUiFreq() {
						return Math.min(20000, nyquist() * 0.98);
					}

					// Assigning to AudioParam.value steps the value, and a step in a biquad's
					// coefficients while its delay line is full is exactly what produces the clicks
					// and zipper noise you hear when dragging. Ramp to the target instead: each
					// setTargetAtTime picks up from wherever the previous ramp had reached, so a
					// stream of drag events becomes one continuous glide.
					function setParam(param, value, tc) {
						if (!audioContext) {
							param.value = value;
							return;
						}
						const now = audioContext.currentTime;
						if (tc === 0) {
							param.cancelScheduledValues(now);
							param.setValueAtTime(value, now);
						} else {
							param.setTargetAtTime(value, now, tc === undefined ? PARAM_TC : tc);
						}
					}

					// Web Audio reads Q in dB for lowpass/highpass and linearly for every other
					// type. Store one linear Q and convert on the way out, so a slider position
					// means the same amount of resonance whatever type the band is set to.
					function writeQ(band, tc) {
						const isDbQ = band.type === "lowpass" || band.type === "highpass";
						setParam(band.node.Q, isDbQ ? 20 * Math.log10(band.q) : band.q, tc);
					}

					function butterworthQs(order) {
						const qs = [];
						for (let k = 0; k < order / 2; k++) {
							qs.push(1 / (2 * Math.cos((Math.PI * (2 * k + 1)) / (2 * order))));
						}
						return qs;
					}

					// Linear below the knee, tanh above it. The limiter keeps the signal well under
					// the knee for anything sustained, so this only ever sees isolated transients,
					// and it rounds those off instead of letting the output stage slice them into
					// the square-wave edge that hard clipping produces.
					function makeSoftClipCurve(samples) {
						const curve = new Float32Array(samples);
						const range = 1 - CLIP_KNEE;
						for (let i = 0; i < samples; i++) {
							const x = ((i / (samples - 1)) * 2 - 1) * CLIP_HEADROOM;
							const a = Math.abs(x);
							curve[i] = a <= CLIP_KNEE ? x : Math.sign(x) * (CLIP_KNEE + range * Math.tanh((a - CLIP_KNEE) / range));
						}
						return curve;
					}

					// --- Initialization ---

					function initAudioContext() {
						if (audioContext) return;

						audioContext = new (window.AudioContext || window.webkitAudioContext)();

						analyserNode = audioContext.createAnalyser();
						analyserNode.fftSize = 2 ** parseInt(detailSlider ? detailSlider.value : 12, 10);

						trimNode = audioContext.createGain();
						trimNode.gain.value = 1;

						// Reducing gain distorts far less than reshaping the waveform does, so the
						// limiter takes the overshoot and the waveshaper below only mops up. Measured
						// on a full-scale tone the pair is ~-87 dB THD when it is not being pushed.
						limiterNode = audioContext.createDynamicsCompressor();
						limiterNode.threshold.value = LIMITER_THRESHOLD_DB;
						limiterNode.knee.value = 0;
						limiterNode.ratio.value = 20;
						limiterNode.attack.value = 0.003;
						limiterNode.release.value = 0.25;

						clipInGain = audioContext.createGain();
						clipInGain.gain.value = 1 / CLIP_HEADROOM;

						softClipNode = audioContext.createWaveShaper();
						softClipNode.curve = makeSoftClipCurve(8193);
						softClipNode.oversample = "4x"; // keep clipping products from folding back as aliases

						dryGain = audioContext.createGain();
						dryGain.gain.value = 1;
						wetGain = audioContext.createGain();
						wetGain.gain.value = 0;

						buildSelectionChain();

						if (detailSlider) {
							detailSlider.addEventListener("input", () => {
								analyserNode.fftSize = 2 ** parseInt(detailSlider.value, 10);
								spectrumData = null;
							});
						}
					}

					// Cascaded Butterworth sections per edge. A single biquad per edge has a resonant
					// peak at its cutoff and only reaches about 11 dB/oct in practice, so it both
					// colours the band it is meant to pass and leaks most of what it is meant to
					// reject. Cascading gives a flat passband and 6 dB/oct per section.
					//
					// Fixed at 96 dB/oct. Steepness costs ring-out after a transient, and that cost
					// is not constant: measured, ring_ms is about 420 * order / lowEdge, so this order
					// rings 1 ms at 6-12 kHz but 225 ms at 30-60 Hz. Isolating deep bass will
					// therefore smear transients; that is the accepted trade for rejecting everything
					// outside the band as hard as a cascade of biquads can.
					function buildSelectionChain() {
						const qs = butterworthQs(SELECTION_ORDER);
						selectionHighpass = qs.map((q) => {
							const hp = audioContext.createBiquadFilter();
							hp.type = "highpass";
							hp.frequency.value = MIN_FREQ;
							hp.Q.value = 20 * Math.log10(q); // dB, per the lowpass/highpass Q convention
							return hp;
						});
						selectionLowpass = qs.map((q) => {
							const lp = audioContext.createBiquadFilter();
							lp.type = "lowpass";
							lp.frequency.value = maxUiFreq();
							lp.Q.value = 20 * Math.log10(q);
							return lp;
						});
					}

					// Swapping filter nodes mid-stream would click, so mute the wet path across the
					// rebuild and bring it back once the new cascade is wired and settled.
					function connectAudioNodes() {
						if (!audioContext) return;

						// Tear the whole graph down before rewiring. Disconnecting only the source
						// leaves every old filter-to-filter edge in place, so after adding a band the
						// signal reached the output through several parallel paths at once: they sum
						// (several dB of extra level, straight into clipping) and comb-filter.
						if (sourceNode) sourceNode.disconnect();
						bands.forEach((band) => band.node.disconnect());
						selectionHighpass.forEach((f) => f.disconnect());
						selectionLowpass.forEach((f) => f.disconnect());
						dryGain.disconnect();
						wetGain.disconnect();
						trimNode.disconnect();
						limiterNode.disconnect();
						clipInGain.disconnect();
						softClipNode.disconnect();
						analyserNode.disconnect();

						if (!sourceNode) return;

						let node = sourceNode;
						for (const band of bands) {
							node.connect(band.node);
							node = band.node;
						}

						// The selection filters sit on a parallel path that is crossfaded in, so with
						// no selection active the audio is untouched rather than passing through two
						// filters parked at the edges of the band.
						node.connect(dryGain);
						let sel = node;
						for (const f of selectionHighpass.concat(selectionLowpass)) {
							sel.connect(f);
							sel = f;
						}
						sel.connect(wetGain);

						dryGain.connect(trimNode);
						wetGain.connect(trimNode);
						trimNode.connect(limiterNode);
						limiterNode.connect(clipInGain);
						clipInGain.connect(softClipNode);
						softClipNode.connect(analyserNode);
						analyserNode.connect(audioContext.destination);
					}

					// --- Output level protection ---

					let respFreqs = null;
					let respMag = null;
					let respPhase = null;
					let respTotal = null;

					function ensureResponseBuffers() {
						if (respFreqs) return;
						respFreqs = new Float32Array(RESPONSE_POINTS);
						respMag = new Float32Array(RESPONSE_POINTS);
						respPhase = new Float32Array(RESPONSE_POINTS);
						respTotal = new Float32Array(RESPONSE_POINTS);
						const minLog = Math.log10(MIN_FREQ);
						const maxLog = Math.log10(maxUiFreq());
						for (let i = 0; i < RESPONSE_POINTS; i++) {
							respFreqs[i] = Math.pow(10, minLog + (i / (RESPONSE_POINTS - 1)) * (maxLog - minLog));
						}
					}

					function updateEqResponse() {
						ensureResponseBuffers();
						respTotal.fill(1);
						for (const band of bands) {
							band.node.getFrequencyResponse(respFreqs, respMag, respPhase);
							for (let i = 0; i < RESPONSE_POINTS; i++) respTotal[i] *= respMag[i];
						}
						let peak = 0;
						for (let i = 0; i < RESPONSE_POINTS; i++) {
							if (respTotal[i] > peak) peak = respTotal[i];
						}
						return peak;
					}

					// Ask the filters what they are actually doing rather than adding up slider
					// values: this accounts for overlapping bands reinforcing each other and for the
					// resonant peak a high-Q lowpass/highpass adds, neither of which is visible from
					// the gain sliders. Most music is mastered close to full scale, so a boost with
					// nothing taken back off is the main reason this page distorted.
					function updateAutoTrim() {
						if (!audioContext || !trimNode) return;
						const peak = updateEqResponse();
						const trim = autoTrimEnabled && peak > 1 ? 1 / peak : 1;
						setParam(trimNode.gain, trim, TRIM_TC);
						if (autoTrimReadout) {
							const db = 20 * Math.log10(trim);
							autoTrimReadout.textContent = `${db < -0.05 ? db.toFixed(1) : "0.0"} dB`;
						}
						if (limitIndicator) {
							// Say so when the safety net is carrying the signal, rather than letting it
							// just sound quieter or duller for no visible reason. The reading jitters
							// frame to frame, so smooth it, and set the bar well past the ~1 dB the
							// limiter takes off any full-scale master: this should mean "the signal is
							// genuinely over", not "this track is loud".
							smoothedReduction += (limiterNode.reduction - smoothedReduction) * 0.15;
							limitIndicator.classList.toggle("hidden", smoothedReduction > LIMIT_INDICATOR_DB);
						}
					}

					if (autoTrimToggle) {
						autoTrimToggle.addEventListener("change", () => {
							autoTrimEnabled = autoTrimToggle.checked;
							updateAutoTrim();
						});
					}

					// --- File Handling ---

					audioFileInput.addEventListener("change", (e) => {
						const file = e.target.files[0];
						if (file) {
							if (isPlaying) {
								audioPlayer.pause();
								isPlaying = false;
							}

							// Reset play button to show play icon when new song is loaded
							playIcon.classList.remove("hidden");
							pauseIcon.classList.add("hidden");

							const objectUrl = URL.createObjectURL(file);
							audioPlayer.src = objectUrl;
							playPauseBtn.disabled = false;
							seekBar.disabled = false;

							// Show EQ header when file is loaded
							const eqHeader = document.getElementById("eq-header");
							if (eqHeader) {
								eqHeader.classList.remove("hidden");
								eqHeader.style.display = "flex";
							}

							if (!audioContext) {
								initAudioContext();
							}

							if (!sourceNode) {
								sourceNode = audioContext.createMediaElementSource(audioPlayer);
							}

							connectAudioNodes();
						}
					});

					// --- Canvas and Visualization ---

					function resizeCanvas() {
						canvas.width = visualizerWrapper.clientWidth;
						canvas.height = visualizerWrapper.clientHeight;
						spectrumColumnsKey = "";
						barGradient = null;
						for (let i = 0; i < bands.length; i++) updatePointPosition(i);
					}
					window.addEventListener("resize", resizeCanvas);
					resizeCanvas();

					function freqToX(freq, maxFreq) {
						const minLog = Math.log10(MIN_FREQ);
						const maxLog = Math.log10(maxFreq);
						const percent = (Math.log10(freq) - minLog) / (maxLog - minLog);
						return AXIS_PAD + percent * (canvas.width - AXIS_PAD);
					}

					// Exact inverse of freqToX. These two used to disagree by the axis padding, so a
					// dragged selection isolated a different range than the one drawn on screen, and
					// a dragged EQ point jumped away from the cursor.
					function xToFreq(x, maxFreq) {
						const minLog = Math.log10(MIN_FREQ);
						const maxLog = Math.log10(maxFreq);
						const percent = (x - AXIS_PAD) / (canvas.width - AXIS_PAD);
						return Math.pow(10, minLog + percent * (maxLog - minLog));
					}

					// The FFT returns linearly spaced bins but the axis is logarithmic, so the bins
					// are badly maldistributed against it. At the default detail the top octave has
					// ~1100 bins competing for 101 px while the 20-40 Hz octave has 2 bins to fill
					// 91 px. Drawing one rect per bin therefore spent thousands of overlapping draws
					// on the right, where all but the last one per pixel were painted over anyway,
					// and left the bass as a handful of wide blocks. Draw a fixed column every couple
					// of pixels instead, and let each column aggregate whatever bins land in it.
					function rebuildSpectrumColumns() {
						if (!analyserNode || !audioContext) return;

						const bins = analyserNode.frequencyBinCount;
						const key = `${canvas.width}:${bins}:${audioContext.sampleRate}`;
						if (key === spectrumColumnsKey) return;
						spectrumColumnsKey = key;

						const maxFreq = nyquist();
						const binWidth = maxFreq / bins; // bin i is centred on i * binWidth
						const plotWidth = canvas.width - AXIS_PAD;
						const count = Math.max(1, Math.round(plotWidth / SPECTRUM_BAR_PX));

						spectrumColumns = [];
						for (let i = 0; i < count; i++) {
							const x0 = AXIS_PAD + (i / count) * plotWidth;
							const x1 = AXIS_PAD + ((i + 1) / count) * plotWidth;
							const f0 = xToFreq(x0, maxFreq);
							const f1 = xToFreq(x1, maxFreq);
							spectrumColumns.push({
								x: x0,
								w: x1 - x0,
								binLo: Math.max(0, Math.ceil(f0 / binWidth)),
								binHi: Math.min(bins - 1, Math.ceil(f1 / binWidth) - 1),
								// fractional bin index at the column's centre, for the low end where the
								// column is narrower than a bin and no bin centre falls inside it
								binMid: Math.sqrt(f0 * f1) / binWidth
							});
						}
					}

					function gainToY(db) {
						return (1 - db / MAX_GAIN_DB) * (canvas.height / 2);
					}

					function draw() {
						requestAnimationFrame(draw);
						if (!analyserNode) return;

						const bufferLength = analyserNode.frequencyBinCount;
						if (!spectrumData || spectrumData.length !== bufferLength) {
							spectrumData = new Uint8Array(bufferLength);
						}
						analyserNode.getByteFrequencyData(spectrumData);

						updateAutoTrim();
						rebuildSpectrumColumns();

						ctx.clearRect(0, 0, canvas.width, canvas.height);

						// Gradient for bars, built once per size rather than once per frame
						if (!barGradient) {
							barGradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
							barGradient.addColorStop(0, "#fbcfe8");
							barGradient.addColorStop(1, "#f9a8d4");
						}
						ctx.fillStyle = barGradient;

						const maxFreq = nyquist();

						for (const col of spectrumColumns) {
							let value;
							if (col.binHi >= col.binLo) {
								// Peak, not mean: hundreds of bins share a column up at the top, and
								// averaging would bury a narrow tone under the quiet bins beside it.
								value = 0;
								for (let i = col.binLo; i <= col.binHi; i++) {
									if (spectrumData[i] > value) value = spectrumData[i];
								}
							} else {
								// Down in the bass a column is a fraction of one bin wide, so read
								// between the two nearest bins rather than repeating one as a flat block.
								const i0 = Math.min(bufferLength - 2, Math.max(0, Math.floor(col.binMid)));
								const t = Math.min(1, Math.max(0, col.binMid - i0));
								value = spectrumData[i0] + (spectrumData[i0 + 1] - spectrumData[i0]) * t;
							}

							const barHeight = (value / 255) * canvas.height;
							ctx.fillRect(col.x, canvas.height - barHeight, col.w, barHeight);
						}

						// Draw frequency labels
						drawFreqLabels(maxFreq);

						// Draw the combined EQ curve
						drawResponseCurve(maxFreq);

						// Draw selection rectangle
						if (isSelectingRange || selectionRect.startX !== selectionRect.endX) {
							ctx.fillStyle = "rgba(59, 130, 246, 0.2)";
							const start = Math.min(selectionRect.startX, selectionRect.endX);
							const width = Math.abs(selectionRect.endX - selectionRect.startX);
							ctx.fillRect(start, 0, width, canvas.height);

							ctx.strokeStyle = "rgba(96, 165, 250, 0.8)";
							ctx.lineWidth = 1;
							ctx.strokeRect(start, 0, width, canvas.height);
						}
					}

					function drawFreqLabels(maxFreq) {
						const labels = [20, 30, 60, 100, 250, 500, 1000, 2000, 5000, 10000, 20000];
						ctx.fillStyle = "#000000";
						ctx.font = "bold 10px DM Sans Variable";
						ctx.textAlign = "center";

						labels.forEach((freq) => {
							if (freq < maxFreq) {
								const x = freqToX(freq, maxFreq);
								ctx.fillText(`${freq < 1000 ? freq : freq / 1000 + "k"}Hz`, x, canvas.height - 10);
								// Draw vertical line
								ctx.beginPath();
								ctx.moveTo(x, 0);
								ctx.lineTo(x, canvas.height - 25);
								ctx.strokeStyle = "rgba(255, 255, 255, 0.1)";
								ctx.stroke();
							}
						});
					}

					// The same magnitude response the auto-trim is measured from, so a boost that
					// costs output level is visible rather than just audible.
					function drawResponseCurve(maxFreq) {
						if (!respTotal || bands.length === 0) return;

						ctx.beginPath();
						ctx.moveTo(AXIS_PAD, gainToY(0));
						ctx.lineTo(canvas.width, gainToY(0));
						ctx.strokeStyle = "rgba(88, 28, 135, 0.2)";
						ctx.lineWidth = 1;
						ctx.stroke();

						ctx.beginPath();
						for (let i = 0; i < RESPONSE_POINTS; i++) {
							const db = Math.max(-MAX_GAIN_DB, Math.min(MAX_GAIN_DB, 20 * Math.log10(Math.max(respTotal[i], 1e-6))));
							const x = freqToX(respFreqs[i], maxFreq);
							const y = gainToY(db);
							if (i === 0) ctx.moveTo(x, y);
							else ctx.lineTo(x, y);
						}
						ctx.strokeStyle = "rgba(88, 28, 135, 0.85)";
						ctx.lineWidth = 2;
						ctx.stroke();
					}

					// --- EQ Controls ---

					function freqLabel(freq) {
						return freq < 1000 ? Math.round(freq) + " Hz" : (freq / 1000).toFixed(1) + " kHz";
					}

					function createEQControls() {
						visualizerWrapper.querySelectorAll(".eq-point").forEach((p) => p.remove());
						eqDetailsContainer.innerHTML = "";

						const maxFreq = maxUiFreq();

						bands.forEach((band, index) => {
							// Create draggable point
							const point = document.createElement("div");
							point.className =
								"eq-point absolute w-4 h-4 bg-viola-800 border-2 border-white rounded-full cursor-grab shadow-lg transform -translate-x-1/2 -translate-y-1/2 hover:bg-viola-900 transition-colors";
							point.dataset.index = index;
							visualizerWrapper.appendChild(point);

							const hasGain = band.type !== "lowpass" && band.type !== "highpass";
							const hasQ = band.type !== "lowshelf" && band.type !== "highshelf";

							// Create detail card
							const card = document.createElement("div");
							card.className = "bg-viola-200 p-3 rounded-lg text-sm border border-viola-300 relative";
							card.innerHTML = `
                        <div class="flex items-center justify-between mb-2">
                            <p class="font-bold text-center flex-1" id="freq-display-${index}">${freqLabel(band.freq)}</p>
                            <button class="remove-band-btn ml-2 px-2 py-1 bg-viola-600 hover:bg-viola-700 rounded-sm text-xs font-medium text-white transition" data-index="${index}">×</button>
                        </div>
                        <div class="mt-2">
                            <label for="freq-${index}" class="block text-xs">Frequency: <span id="freq-val-${index}">${freqLabel(band.freq)}</span></label>
                            <input type="range" id="freq-${index}" min="20" max="${maxFreq}" value="${band.freq}" step="1" class="w-full h-1.5 bg-viola-50 rounded-lg appearance-none cursor-pointer [&::-moz-range-thumb]:h-4 [&::-moz-range-thumb]:w-4 [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:bg-viola-500 [&::-moz-range-thumb]:transition [&::-moz-range-thumb]:hover:bg-viola-600 [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-viola-500 [&::-webkit-slider-thumb]:transition [&::-webkit-slider-thumb]:hover:bg-viola-600">
                        </div>
                        <div class="mt-2" id="gain-container-${index}" ${hasGain ? "" : 'style="display: none;"'}>
                            <label for="gain-${index}" class="block text-xs">Gain: <span id="gain-val-${index}">${band.gain.toFixed(1)} dB</span></label>
                            <input type="range" id="gain-${index}" min="-20" max="20" value="${band.gain}" step="0.1" class="w-full h-1.5 bg-viola-50 rounded-lg appearance-none cursor-pointer [&::-moz-range-thumb]:h-4 [&::-moz-range-thumb]:w-4 [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:bg-viola-500 [&::-moz-range-thumb]:transition [&::-moz-range-thumb]:hover:bg-viola-600 [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-viola-500 [&::-webkit-slider-thumb]:transition [&::-webkit-slider-thumb]:hover:bg-viola-600">
                        </div>
                        <div class="mt-2">
                            <label for="type-${index}" class="block text-xs">Type:</label>
                            <select id="type-${index}" class="w-full mt-1 px-2 py-1 bg-viola-50 border border-viola-300 rounded-sm text-xs">
                                <option value="peaking" ${band.type === "peaking" ? "selected" : ""}>Peaking</option>
                                <option value="lowshelf" ${band.type === "lowshelf" ? "selected" : ""}>Low Shelf</option>
                                <option value="highshelf" ${band.type === "highshelf" ? "selected" : ""}>High Shelf</option>
                                <option value="lowpass" ${band.type === "lowpass" ? "selected" : ""}>Low Pass</option>
                                <option value="highpass" ${band.type === "highpass" ? "selected" : ""}>High Pass</option>
                            </select>
                        </div>
                        <div class="mt-2" id="q-container-${index}" ${hasQ ? "" : 'style="display: none;"'}>
                            <label for="q-${index}" class="block text-xs">Q: <span id="q-val-${index}">${band.q.toFixed(2)}</span></label>
                            <input type="range" id="q-${index}" min="0.1" max="18" value="${band.q}" step="0.1" class="w-full h-1.5 bg-viola-50 rounded-lg appearance-none cursor-pointer [&::-moz-range-thumb]:h-4 [&::-moz-range-thumb]:w-4 [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:bg-viola-500 [&::-moz-range-thumb]:transition [&::-moz-range-thumb]:hover:bg-viola-600 [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-viola-500 [&::-webkit-slider-thumb]:transition [&::-webkit-slider-thumb]:hover:bg-viola-600">
                        </div>
                    `;
							eqDetailsContainer.appendChild(card);

							updatePointPosition(index);

							// Event listeners for card controls
							const freqSlider = card.querySelector(`#freq-${index}`);
							freqSlider.addEventListener("input", (e) => {
								band.freq = parseFloat(e.target.value);
								setParam(band.node.frequency, band.freq);
								updatePointPosition(index);
								card.querySelector(`#freq-val-${index}`).textContent = freqLabel(band.freq);
								card.querySelector(`#freq-display-${index}`).textContent = freqLabel(band.freq);
							});

							const gainSlider = card.querySelector(`#gain-${index}`);
							gainSlider.addEventListener("input", (e) => {
								band.gain = parseFloat(e.target.value);
								setParam(band.node.gain, band.gain);
								updatePointPosition(index);
								card.querySelector(`#gain-val-${index}`).textContent = `${band.gain.toFixed(1)} dB`;
							});

							const typeSelect = card.querySelector(`#type-${index}`);
							typeSelect.addEventListener("change", (e) => {
								band.type = e.target.value;
								band.node.type = band.type;
								writeQ(band, 0); // the Q convention changes with the type, so rewrite it
								card.querySelector(`#q-container-${index}`).style.display = band.type === "lowshelf" || band.type === "highshelf" ? "none" : "block";
								card.querySelector(`#gain-container-${index}`).style.display = band.type === "lowpass" || band.type === "highpass" ? "none" : "block";
							});

							const qSlider = card.querySelector(`#q-${index}`);
							qSlider.addEventListener("input", (e) => {
								band.q = parseFloat(e.target.value);
								writeQ(band);
								card.querySelector(`#q-val-${index}`).textContent = band.q.toFixed(2);
							});

							// Remove band button
							const removeBtn = card.querySelector(".remove-band-btn");
							removeBtn.addEventListener("click", () => {
								removeBand(index);
							});
						});

						addPointEventListeners();
						updateAutoTrim();
					}

					function updatePointPosition(index) {
						const point = visualizerWrapper.querySelector(`.eq-point[data-index='${index}']`);
						const band = bands[index];
						if (!point || !band) return;

						// The element already centres itself with a -translate-x/y-1/2 transform;
						// subtracting half its size here as well pushed every point off by its radius.
						point.style.left = `${freqToX(band.freq, nyquist())}px`;
						point.style.top = `${gainToY(band.gain)}px`;
					}

					function addPointEventListeners() {
						const points = visualizerWrapper.querySelectorAll(".eq-point");
						points.forEach((point) => {
							point.addEventListener("mousedown", (e) => {
								isDraggingPoint = e.target;
								e.target.style.cursor = "grabbing";
							});
							point.addEventListener(
								"touchstart",
								(e) => {
									isDraggingPoint = e.target;
									e.preventDefault();
								},
								{ passive: false }
							);
						});
					}

					visualizerWrapper.addEventListener("mousemove", (e) => {
						if (isDraggingPoint) {
							handlePointMove(e.clientX, e.clientY);
						} else if (isSelectingRange) {
							selectionRect.endX = plotX(e.clientX);
						}
					});
					visualizerWrapper.addEventListener(
						"touchmove",
						(e) => {
							if (isDraggingPoint) {
								handlePointMove(e.touches[0].clientX, e.touches[0].clientY);
							} else if (isSelectingRange) {
								selectionRect.endX = plotX(e.touches[0].clientX);
							}
							e.preventDefault();
						},
						{ passive: false }
					);

					function clampToPlot(x) {
						return Math.max(AXIS_PAD, Math.min(canvas.width, x));
					}

					// Measure against the canvas, not its wrapper. The wrapper has a 1px border, so
					// reading from its bounding box offsets every coordinate by a pixel, and one pixel
					// at the bottom of a log frequency axis is worth several Hz.
					function plotX(clientX) {
						return clampToPlot(clientX - canvas.getBoundingClientRect().left);
					}

					function handlePointMove(clientX, clientY) {
						const rect = canvas.getBoundingClientRect();
						const index = isDraggingPoint.dataset.index;
						const band = bands[index];
						if (!band) return;

						// Update gain (vertical movement)
						const yPercent = (clientY - rect.top) / rect.height;
						band.gain = Math.max(-MAX_GAIN_DB, Math.min(MAX_GAIN_DB, (1 - 2 * yPercent) * MAX_GAIN_DB));
						setParam(band.node.gain, band.gain);

						// Update frequency (horizontal movement)
						band.freq = Math.max(MIN_FREQ, Math.min(maxUiFreq(), xToFreq(plotX(clientX), nyquist())));
						setParam(band.node.frequency, band.freq);

						updatePointPosition(index);

						// Update detail card
						const freqSlider = eqDetailsContainer.querySelector(`#freq-${index}`);
						const freqValSpan = eqDetailsContainer.querySelector(`#freq-val-${index}`);
						const freqDisplaySpan = eqDetailsContainer.querySelector(`#freq-display-${index}`);
						const gainSlider = eqDetailsContainer.querySelector(`#gain-${index}`);
						const gainValSpan = eqDetailsContainer.querySelector(`#gain-val-${index}`);

						if (freqSlider) {
							freqSlider.value = band.freq;
							freqValSpan.textContent = freqLabel(band.freq);
							freqDisplaySpan.textContent = freqLabel(band.freq);
						}

						if (gainSlider) {
							gainSlider.value = band.gain;
							gainValSpan.textContent = `${band.gain.toFixed(1)} dB`;
						}
					}

					window.addEventListener("mouseup", () => {
						if (isDraggingPoint) {
							isDraggingPoint.style.cursor = "grab";
							isDraggingPoint = null;
						}
					});
					window.addEventListener("touchend", () => {
						if (isDraggingPoint) {
							isDraggingPoint.style.cursor = "grab";
							isDraggingPoint = null;
						}
					});

					// --- Frequency Range Selection ---

					visualizerWrapper.addEventListener("mousedown", (e) => {
						// Only start selection if not dragging a point
						if (!e.target.classList.contains("eq-point")) {
							isSelectingRange = true;
							selectionRect.startX = plotX(e.clientX);
							selectionRect.endX = selectionRect.startX;
						}
					});

					window.addEventListener("mouseup", () => {
						if (isSelectingRange) {
							isSelectingRange = false;
							if (!audioContext) return;

							const maxFreq = nyquist();
							const freq1 = xToFreq(selectionRect.startX, maxFreq);
							const freq2 = xToFreq(selectionRect.endX, maxFreq);

							selectionRect.startFreq = Math.min(freq1, freq2);
							selectionRect.endFreq = Math.max(freq1, freq2);

							// Don't apply if selection is too small
							if (Math.abs(selectionRect.endX - selectionRect.startX) > 5) {
								applyFrequencySelection();
							} else {
								resetFrequencySelection();
							}
						}
					});

					function applyFrequencySelection() {
						if (!audioContext) return;

						// Clamp to a range the filters can actually realise. Cutoffs at or past
						// Nyquist make the biquad coefficients degenerate, and two edges pushed on top
						// of each other leave nothing but the ringing where they overlap.
						let lo = Math.max(MIN_FREQ, Math.min(selectionRect.startFreq, selectionRect.endFreq));
						lo = Math.min(lo, maxUiFreq() / MIN_SELECTION_RATIO);
						const hi = Math.min(maxUiFreq(), Math.max(Math.max(selectionRect.startFreq, selectionRect.endFreq), lo * MIN_SELECTION_RATIO));

						selectionRect.startFreq = lo;
						selectionRect.endFreq = hi;
						resetSelectionBtn.classList.remove("hidden");

						// Already-active selections glide to the new cutoffs; an inactive one is placed
						// silently and then faded in, so neither case snaps the coefficients.
						const tc = selectionActive ? PARAM_TC : 0;
						selectionHighpass.forEach((f) => setParam(f.frequency, lo, tc));
						selectionLowpass.forEach((f) => setParam(f.frequency, hi, tc));

						setParam(wetGain.gain, 1, XFADE_TC);
						setParam(dryGain.gain, 0, XFADE_TC);
						selectionActive = true;
					}

					function resetFrequencySelection() {
						selectionRect = { startX: 0, endX: 0, startFreq: 0, endFreq: 0 };
						resetSelectionBtn.classList.add("hidden");
						if (!audioContext) return;

						setParam(wetGain.gain, 0, XFADE_TC);
						setParam(dryGain.gain, 1, XFADE_TC);
						selectionActive = false;
					}

					resetSelectionBtn.addEventListener("click", resetFrequencySelection);

					// --- Parametric EQ Functions ---

					function addBand() {
						if (!audioContext) return;

						const node = audioContext.createBiquadFilter();
						const band = { node, type: "peaking", freq: 1000, gain: 0, q: 1.41 };
						node.type = band.type;
						node.frequency.value = band.freq;
						node.gain.value = band.gain;
						writeQ(band, 0);

						bands.push(band);
						connectAudioNodes();
						createEQControls();
					}

					function removeBand(index) {
						// Disconnect the filter
						bands[index].node.disconnect();

						// Remove from array
						bands.splice(index, 1);

						// Reconnect audio chain and recreate controls
						connectAudioNodes();
						createEQControls();
					}

					function resetEQ() {
						if (!audioContext) return;

						bands.forEach((band) => {
							band.type = "peaking";
							band.gain = 0;
							band.q = 1.41;
							band.node.type = band.type;
							setParam(band.node.gain, band.gain);
							writeQ(band, 0);
						});

						connectAudioNodes();
						createEQControls();
					}

					// Event listeners for parametric controls
					addBandBtn.addEventListener("click", addBand);
					resetEqBtn.addEventListener("click", resetEQ);

					// --- Playback Controls ---
					playPauseBtn.addEventListener("click", () => {
						if (!audioContext) return;

						if (audioContext.state === "suspended") {
							audioContext.resume();
						}

						if (isPlaying) {
							audioPlayer.pause();
						} else {
							audioPlayer.play();
						}
					});

					audioPlayer.addEventListener("play", () => {
						isPlaying = true;
						playIcon.classList.add("hidden");
						pauseIcon.classList.remove("hidden");
					});

					audioPlayer.addEventListener("pause", () => {
						isPlaying = false;
						playIcon.classList.remove("hidden");
						pauseIcon.classList.add("hidden");
					});

					audioPlayer.addEventListener("timeupdate", () => {
						seekBar.value = audioPlayer.currentTime;
						currentTimeDisplay.textContent = formatTime(audioPlayer.currentTime);
					});

					audioPlayer.addEventListener("loadedmetadata", () => {
						durationDisplay.textContent = formatTime(audioPlayer.duration);
						seekBar.max = audioPlayer.duration;
					});

					seekBar.addEventListener("input", () => {
						audioPlayer.currentTime = seekBar.value;
					});

					function formatTime(seconds) {
						const minutes = Math.floor(seconds / 60);
						const secs = Math.floor(seconds % 60);
						return `${minutes}:${secs < 10 ? "0" : ""}${secs}`;
					}

					// --- Initial App State ---
					function initApp() {
						initAudioContext();
						createEQControls();
						draw();
					}

					// Await user interaction for autoplay policy
					document.body.addEventListener("click", initApp, { once: true });
				}
			</script>
		</div>
	</div>
</Layout>
