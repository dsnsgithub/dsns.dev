---
export const prerender = false;

import { Octokit } from "@octokit/rest";
import { Icon } from "astro-icon/components";
import RepoCard from "./RepoCard.astro";

interface DisplayRepo {
	owner: string;
	name: string;
	description: string;
	url: string;
	stars: number;
	language?: string;
}

const octokit = new Octokit({
	auth: import.meta.env.GITHUB_TOKEN
});

const GITHUB_USERNAME = "dsnsgithub";
const STARRED_COUNT = 6;

async function fetchPinnedRepos(): Promise<DisplayRepo[]> {
	// Pinned repositories are only exposed through the GraphQL API.
	const response = await fetch("https://api.github.com/graphql", {
		method: "POST",
		headers: {
			Authorization: `Bearer ${import.meta.env.GITHUB_TOKEN}`,
			"Content-Type": "application/json"
		},
		body: JSON.stringify({
			query: `
				query ($login: String!) {
					user(login: $login) {
						pinnedItems(first: 6, types: REPOSITORY) {
							nodes {
								... on Repository {
									name
									description
									url
									stargazerCount
									primaryLanguage { name }
									owner { login }
								}
							}
						}
					}
				}
			`,
			variables: { login: GITHUB_USERNAME }
		})
	});

	const json = await response.json();
	const items: Array<Record<string, any>> = json.data?.user?.pinnedItems?.nodes ?? [];

	return items.map((repo) => ({
		owner: repo.owner.login,
		name: repo.name,
		description: repo.description ?? "",
		url: repo.url,
		stars: repo.stargazerCount,
		language: repo.primaryLanguage?.name
	}));
}

async function fetchStarredRepos(): Promise<DisplayRepo[]> {
	const res = await octokit.rest.activity.listReposStarredByUser({
		username: GITHUB_USERNAME,
		sort: "created",
		direction: "desc",
		per_page: STARRED_COUNT
	});

	return res.data.map((item) => {
		const repo = "repo" in item ? item.repo : item;

		return {
			owner: repo.owner.login,
			name: repo.name,
			description: repo.description ?? "",
			url: repo.html_url,
			stars: repo.stargazers_count,
			language: repo.language ?? undefined
		};
	});
}

function sortRepos(repos: DisplayRepo[]): DisplayRepo[] {
	return [...repos].sort((a, b) => b.stars - a.stars);
}

const [pinned, starred] = await Promise.all([fetchPinnedRepos(), fetchStarredRepos()]);
---

<div class="flex flex-col gap-6">
	{pinned.length === 0 && starred.length === 0 && (
		<p class="py-4 text-center text-gray-500">No repositories found.</p>
	)}

	{
		pinned.length > 0 && (
			<div>
				<h3 class="mb-3 flex items-center gap-2 text-lg font-bold">
					<Icon name="mdi:pin" class="text-viola-700" />
					Pinned Repositories
				</h3>
				<div class="grid gap-3 sm:grid-cols-2">
					{pinned.map((repo) => (
						<RepoCard owner={repo.owner} name={repo.name} description={repo.description} url={repo.url} stars={repo.stars} language={repo.language} />
					))}
				</div>
			</div>
		)
	}

	{
		starred.length > 0 && (
			<div>
				<h3 class="mb-3 flex items-center gap-2 text-lg font-bold">
					<Icon name="mdi:star" class="text-viola-700" />
					Repositories I Find Cool
				</h3>
				<div class="grid gap-3 sm:grid-cols-2">
					{sortRepos(starred).map((repo) => (
						<RepoCard owner={repo.owner} name={repo.name} description={repo.description} url={repo.url} stars={repo.stars} language={repo.language} />
					))}
				</div>
			</div>
		)
	}
</div>
